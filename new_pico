#!/bin/bash

# Read the default config
echo "$0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ ! -f "$SCRIPT_DIR/new_pico.cfg" ]; then
  echo "Missing config file: $SCRIPT_DIR/new_pico.cfg"
  exit 1
fi

source <(grep -E '^[A-Z_]+=.*' "$SCRIPT_DIR/new_pico.cfg")

# Parse options manually
while [[ "$1" == -* ]]; do
  case "$1" in
    -c|--use_c)
      USE_CPP=OFF
      shift
      ;;
    -f|--force)
      FORCE_CLONE=true
      shift
      ;;
    -n|--no_vscode)
      LAUNCH_VSCODE=false
      shift
      ;;
    -t|--template_path)
      shift
      TEMPLATE_REPO="$1"
      shift
      ;;
    -s|--no_sdk_check)
      SDK_AUTOLOAD=false
      shift
      ;;
    -h|--help)
      echo "Usage: new_pico [options] <project_name>"
      echo ""
      echo "Options:"
      echo "  -h, --help           Show this help text"
      echo "  -c, --use_c          Use C instead of C++ for the project"
      echo "  -f, --force          Force cloning the template, even if it exists in the template path"
      echo "  -n, --no_vscode      Do not launch Visual Studio Code"
      echo "  -s, --no_sdk_check   Do not check Raspberry Pi Pico SDK availability"
      echo "  -t, --template_path  Set an alternative template path"
      exit 0
      ;;
    *)
      echo "Unknown option: $1"
      exit 1
      ;;
  esac
done

NEW_PROJECT=$1 

if [ -d "$NEW_PROJECT" ]; then
  echo "Project '$NEW_PROJECT' already exists. Aborting."
  exit 1
fi

# Check for project name
if [ -z "$1" ]; then
  echo "Usage: $0 [-c|--use_c] [-n|--no_vscode] [-t|--template_path <path>] <new_project_name>"
  exit 1
fi

TARGET_DIR="$TEMPLATE_CACHE$NEW_PROJECT"
echo "--> Target dir    $TARGET_DIR"

# Check template path
if [ ! -d "$TEMPLATE_CACHE" ]; then
  echo "Template cache created : $TEMPLATE_CACHE"
  mkdir "$TEMPLATE_CACHE"
fi

#check the target dir
if [ "$FORCE_CLONE" = true ] || [ ! -d "$TARGET_DIR" ]; then
  echo "Template not found at $TARGET_DIR"
  echo "Cloning default template from GitHub..."
# Clone the template
  rm -rf "$TARGET_DIR"
  git clone "$TEMPLATE_REPO" "$TARGET_DIR"
else
  echo "Templates found at $TARGET_DIR"
fi

if [ ! -f "$TARGET_DIR/CMakeLists.txt" ]; then
  echo "Template folder exists but doesn't contain a valid Pico project."
  exit 1
fi

# Clone the template
git clone "$TARGET_DIR" "$NEW_PROJECT"

# Rename internal references
echo "--> $NEW_PROJECT"
cd "$NEW_PROJECT"
find . -type f -exec sed -i "s/pico_project_template/$NEW_PROJECT/g" {} +
find . -type f -exec sed -i "s/pico-project-template/$NEW_PROJECT/g" {} +
rm -rf build

# Rewrite a dummy README.md
echo "# $NEW_PROJECT" > README.md
echo "" >> README.md
echo "$README_INFO" >> README.md

# Rename workspace file
mv pico-project_template.code-workspace "$NEW_PROJECT.code-workspace"

# Create build system
cmake -S . -B build -G "Unix Makefiles" -DUSE_CPP="$USE_CPP" -DPICO_SDK_PATH="$PICO_SDK_PATH"

# Create git repository
rm -rf .git
git init
git add .
git commit -m "New project $NEW_PROJECT started. Initial commit."

# Verify the Raspberry Pi Pico SDK is installed
if [ "$SDK_AUTOLOAD" = true ] && [ ! -d "$PICO_SDK_PATH" ]; then
    echo "Cloning Raspberry Pi Pico SDK..."
    mkdir -p ${PICO_SDK_PATH%/*}
    git clone https://github.com/raspberrypi/pico-sdk.git "$PICO_SDK_PATH"

    if [ -n "$ZSH_VERSION" ]; then
        CONFIG_FILE="$HOME/.zshrc"
    else
        CONFIG_FILE="$HOME/.bashrc"
    fi

    echo 'export PICO_SDK_PATH='"$PICO_SDK_PATH" >> "$CONFIG_FILE"
    source "$CONFIG_FILE"
fi

# Launch VSCode if requested
if [ "$LAUNCH_VSCODE" = true ]; then
  code "$NEW_PROJECT.code-workspace"
fi
